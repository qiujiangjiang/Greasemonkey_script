(function() {
  if (document.getElementById('batch-delete-panel')) return;

  // ========== 样式 ==========
  const style = document.createElement('style');
  style.textContent = `
    #batch-delete-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.45);
      z-index: 999999998;
    }
    #batch-delete-panel {
      position: fixed; top: 40px; left: 50%;
      transform: translateX(-50%);
      width: 520px; max-height: 80vh;
      background: #fff; border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      display: flex; flex-direction: column;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      z-index: 999999999; overflow: hidden;
    }
    #batch-delete-panel .header {
      padding: 16px 20px; border-bottom: 1px solid #e8e8e8;
      display: flex; align-items: center; justify-content: space-between;
      background: #fafafa;
    }
    #batch-delete-panel .header h3 { margin: 0; font-size: 16px; color: #262626; }
    #batch-delete-panel .header .close-btn {
      background: none; border: none; font-size: 20px; color: #999;
      cursor: pointer; line-height: 1; padding: 0; width: 28px; height: 28px;
      display: flex; align-items: center; justify-content: center; border-radius: 6px;
    }
    #batch-delete-panel .header .close-btn:hover { background: #f0f0f0; color: #444; }
    #batch-delete-panel .toolbar {
      padding: 12px 20px; border-bottom: 1px solid #f0f0f0;
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    #batch-delete-panel .toolbar label { font-size: 13px; color: #595959; cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px; }
    #batch-delete-panel .toolbar button {
      padding: 6px 14px; border-radius: 6px; border: 1px solid #d9d9d9;
      background: #fff; cursor: pointer; font-size: 13px; color: #262626; transition: all .2s;
    }
    #batch-delete-panel .toolbar button:hover { border-color: #1677ff; color: #1677ff; }
    #batch-delete-panel .toolbar button.primary { background: #1677ff; color: #fff; border-color: #1677ff; }
    #batch-delete-panel .toolbar button.primary:hover { background: #4096ff; }
    #batch-delete-panel .toolbar button.danger { background: #ff4d4f; color: #fff; border-color: #ff4d4f; }
    #batch-delete-panel .toolbar button.danger:hover { background: #ff7875; }
    #batch-delete-panel .toolbar button:disabled { opacity: .5; cursor: not-allowed; }
    #batch-delete-panel .list-wrap { flex: 1; overflow-y: auto; padding: 8px 0; }
    #batch-delete-panel .tmpl-item {
      display: flex; align-items: center; padding: 10px 20px;
      border-bottom: 1px solid #f5f5f5; gap: 10px; cursor: pointer;
      transition: background .15s; user-select: none;
    }
    #batch-delete-panel .tmpl-item:hover { background: #f6ffed; }
    #batch-delete-panel .tmpl-item.deleted { opacity: .4; pointer-events: none; text-decoration: line-through; background: #fff2f0; }
    #batch-delete-panel .tmpl-item input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; flex-shrink: 0; }
    #batch-delete-panel .tmpl-item .info { flex: 1; min-width: 0; }
    #batch-delete-panel .tmpl-item .id { font-size: 12px; color: #8c8c8c; font-family: monospace; }
    #batch-delete-panel .tmpl-item .name { font-size: 14px; color: #262626; word-break: break-all; }
    #batch-delete-panel .status-bar {
      padding: 10px 20px; border-top: 1px solid #f0f0f0;
      font-size: 12px; color: #8c8c8c; background: #fafafa;
    }
    #batch-delete-panel .empty { text-align: center; padding: 40px; color: #bfbfbf; font-size: 14px; }
    #batch-delete-panel .loading { text-align: center; padding: 40px; color: #595959; font-size: 14px; }
  `;
  document.head.appendChild(style);

  // ========== DOM ==========
  const overlay = document.createElement('div');
  overlay.id = 'batch-delete-overlay';
  const panel = document.createElement('div');
  panel.id = 'batch-delete-panel';
  panel.innerHTML = `
    <div class="header">
      <h3>批量删除模板</h3>
      <button class="close-btn" title="关闭">&times;</button>
    </div>
    <div class="toolbar">
      <label><input type="checkbox" id="bd-checkall"> 全选</label>
      <button id="bd-refresh">刷新列表</button>
      <button id="bd-delete" class="danger" disabled>批量删除</button>
      <span id="bd-count" style="margin-left:auto;font-size:12px;color:#8c8c8c;"></span>
    </div>
    <div class="list-wrap" id="bd-list"><div class="loading">正在加载模板列表...</div></div>
    <div class="status-bar" id="bd-status">就绪</div>
  `;
  document.body.appendChild(overlay);
  document.body.appendChild(panel);

  const $ = (s) => panel.querySelector(s);
  const listEl = $('#bd-list');
  const statusEl = $('#bd-status');
  const countEl = $('#bd-count');
  const deleteBtn = $('#bd-delete');
  const checkAll = $('#bd-checkall');

  let templates = [];

  function close() { panel.remove(); overlay.remove(); style.remove(); }
  $('.close-btn').onclick = close;
  overlay.onclick = close;

  function setStatus(msg) { statusEl.textContent = msg; }

  // ========== API ==========
  async function fetchTemplates() {
    const all = [];
    let pageNo = 1, totalPages = 1;
    while (pageNo <= totalPages) {
      const res = await fetch(
        `https://galaxy.alibaba-inc.com/creativePlan/listTemplate?pageNo=${pageNo}&pageSize=100&status=1`,
        { headers: { accept: 'application/json, text/plain, */*', appname: 'adcontent-op' }, credentials: 'include' }
      );
      const json = await res.json();
      if (!json.success) throw new Error(json.msgInfo || '请求失败');
      const m = json.model || {};
      all.push(...(m.result || []));
      totalPages = m.totalPages || 1;
      pageNo++;
    }
    return all;
  }

  async function deleteTemplate(id) {
    const res = await fetch('https://galaxy.alibaba-inc.com/creativePlan/deleteTemplate', {
      method: 'POST',
      headers: {
        accept: 'application/json, text/plain, */*',
        'content-type': 'application/json',
        appname: 'adcontent-op'
      },
      credentials: 'include',
      body: JSON.stringify({ id })
    });
    const json = await res.json();
    return json.success && json.model && json.model.success;
  }

  // ========== 渲染 ==========
  function render() {
    if (!templates.length) {
      listEl.innerHTML = '<div class="empty">暂无模板数据</div>';
      updateCount();
      return;
    }
    listEl.innerHTML = '';
    templates.forEach((t, idx) => {
      const row = document.createElement('div');
      row.className = 'tmpl-item' + (t._deleted ? ' deleted' : '');
      row.innerHTML = `
        <input type="checkbox" data-idx="${idx}" ${t._checked ? 'checked' : ''} ${t._deleted ? 'disabled' : ''}>
        <div class="info">
          <div class="id">ID: ${t.id}</div>
          <div class="name">${escapeHtml(t.templateName || '未命名')}</div>
        </div>
      `;
      row.querySelector('input').onchange = (e) => {
        t._checked = e.target.checked;
        syncCheckAll();
        updateDeleteBtn();
      };
      row.onclick = (e) => {
        if (e.target.tagName === 'INPUT' || t._deleted) return;
        const cb = row.querySelector('input');
        cb.checked = !cb.checked;
        t._checked = cb.checked;
        syncCheckAll();
        updateDeleteBtn();
      };
      listEl.appendChild(row);
    });
    updateCount();
  }

  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function updateCount() {
    const total = templates.length;
    const checked = templates.filter(t => t._checked && !t._deleted).length;
    const deleted = templates.filter(t => t._deleted).length;
    countEl.textContent = `共 ${total} 条${deleted ? ` / 已删 ${deleted}` : ''} / 选中 ${checked} 条`;
  }

  function syncCheckAll() {
    const avail = templates.filter(t => !t._deleted);
    checkAll.checked = avail.length > 0 && avail.every(t => t._checked);
  }

  function updateDeleteBtn() {
    const hasChecked = templates.some(t => t._checked && !t._deleted);
    deleteBtn.disabled = !hasChecked;
  }

  // ========== 加载 ==========
  async function load() {
    listEl.innerHTML = '<div class="loading">正在加载模板列表...</div>';
    try {
      templates = (await fetchTemplates()).map(t => ({ ...t, _checked: false, _deleted: false }));
      setStatus(`加载完成，共 ${templates.length} 条模板`);
      render();
    } catch (e) {
      listEl.innerHTML = `<div class="empty" style="color:#ff4d4f">加载失败：${e.message}</div>`;
      setStatus('加载失败');
    }
  }

  // ========== 批量删除 ==========
  deleteBtn.onclick = async () => {
    const targets = templates.filter(t => t._checked && !t._deleted);
    if (!targets.length) return;
    if (!confirm(`确定要删除选中的 ${targets.length} 个模板吗？`)) return;

    deleteBtn.disabled = true;
    let successCount = 0, failCount = 0;

    for (const t of targets) {
      setStatus(`正在删除: ${t.templateName || t.id} ... (${successCount + failCount + 1}/${targets.length})`);
      try {
        const ok = await deleteTemplate(t.id);
        if (ok) {
          t._deleted = true;
          t._checked = false;
          successCount++;
        } else {
          failCount++;
        }
      } catch (e) {
        failCount++;
        console.error('删除失败', t.id, e);
      }
      // 每次删除后刷新视图
      render();
      await new Promise(r => setTimeout(r, 300)); // 简单限流
    }

    setStatus(`删除完成：成功 ${successCount} 条，失败 ${failCount} 条`);
    updateDeleteBtn();
  };

  checkAll.onchange = (e) => {
    const checked = e.target.checked;
    templates.forEach(t => { if (!t._deleted) t._checked = checked; });
    render();
    updateDeleteBtn();
  };

  $('#bd-refresh').onclick = load;

  load();
})();
